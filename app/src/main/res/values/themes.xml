<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Korset_new" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/orange_accent_color</item>
        <item name="android:windowBackground">@color/background_color</item>
        <item name="android:statusBarColor">@color/background_color</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/background_color</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Korset_new" parent="Base.Theme.Korset_new" />

    <!-- Стили для пунктов меню в профиле -->
    <style name="MenuItemLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/clickable_item_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <!-- ... (остальные стили профиля без изменений) -->
    <style name="MenuItemText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_primary_color</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="MenuItemIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="android:tint">@color/text_secondary_color</item>
    </style>
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider_color</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
    </style>

    <!-- === НОВЫЕ СТИЛИ ДЛЯ НИЖНЕГО МЕНЮ === -->

    <!-- Основной стиль для BottomNavigationView -->
    <style name="CustomBottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <!-- Увеличиваем размер иконок -->
        <item name="itemIconSize">28dp</item>
        <!-- Применяем наш стиль для индикатора -->
        <item name="itemActiveIndicatorStyle">@style/CustomBottomNavIndicator</item>
        <!-- Применяем стили для текста -->
        <item name="itemTextAppearanceInactive">@style/BottomNav.Text.Inactive</item>
        <item name="itemTextAppearanceActive">@style/BottomNav.Text.Active</item>
    </style>

    <!-- Стиль для фиолетового индикатора -->
    <style name="CustomBottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <!-- Указываем наш drawable в качестве фона -->
        <item name="android:drawable">@drawable/bottom_nav_indicator</item>
    </style>

    <!-- Стиль для неактивного текста в меню (обычный размер) -->
    <style name="BottomNav.Text.Inactive" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item>
    </style>
    <!-- Стиль для активного текста в меню (увеличенный размер) -->
    <style name="BottomNav.Text.Active" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>